# ClaudeSuite settings. Copy to .env next to docker-compose.yml and fill in.

# The first password of the user "Admin" (at least 12 characters). Log in with it once, then empty this line:
# the password is kept (hashed) in the database.
ADMIN_PASSWORD=

# Forgotten password of "Admin": set to true for one start (with ADMIN_PASSWORD filled in), then remove again.
ADMIN_PASSWORD_RESET=

# How long a device stays logged in (hours; 720 = 30 days)
SESSION_HOURS=720

# Largest file that can be shared in a chat (MB)
MAX_FILE_MB=25
